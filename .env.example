# Copy to .env before running `npm run setup`.
DATABASE_URL="file:./dev.db"

# Change this in any deployed environment.
AUTH_SECRET="replace-with-a-long-random-string"

# Email delivery. When SMTP_HOST is empty, "Send Payslips" records messages in the
# in-app Email Outbox instead of dialling out. Set it to send for real (npm i nodemailer).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="payroll@peoplepay360.com"
