# Copy to .env and adjust. Every value here has a working default in
# docker-compose.yml, so the stack starts without a .env at all — this file is
# for changing ports, pointing at another database, or enabling real email.

# ---------------------------------------------------------------- Database
POSTGRES_USER=peoplepay
POSTGRES_PASSWORD=peoplepay_dev_pw
POSTGRES_DB=peoplepay360
# Published on 5433 so it cannot collide with a Postgres already on the host.
POSTGRES_PORT=5433

# Used by the API when it runs on the host rather than in Compose. Inside the
# Compose network the API reaches the database at db:5432 instead.
DATABASE_URL="postgresql://peoplepay:peoplepay_dev_pw@localhost:5433/peoplepay360?schema=public"

# ---------------------------------------------------------------- API
API_PORT=4000
# Change this anywhere real. Every issued token is signed with it, so rotating
# it signs everyone out.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------- Web
WEB_PORT=3000
# Baked into the browser bundle at build time, so changing it needs a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------- Email
# Delivery is chosen by what is configured, not by a flag: Azure Communication
# Services if it has a connection string, SMTP if it has a host, otherwise the
# attempt is only recorded in the in-app outbox. That last case is the default,
# so the bulk-send flow is demonstrable without credentials.

# Azure Communication Services. Take the connection string from the resource's
# Keys blade. The sender must be a verified address on the ACS domain — Azure
# rejects anything else outright.
ACS_EMAIL_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# SMTP, used only when there is no ACS connection string. Needs nodemailer:
# npm i nodemailer -w @peoplepay360/api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The From address on SMTP mail. ACS uses ACS_SENDER_ADDRESS instead, because
# it will only send as a sender it has verified.
MAIL_FROM=payroll@peoplepay360.com
