# Leftover SQLite database from the pre-PostgreSQL version. Anchored with a
# leading slash: a bare `prisma/` matches at any depth and would silently
# swallow api/prisma, which holds the schema, migrations and seed.
/prisma/

# Tool-specific agent pointer, regenerated locally.
frontend/CLAUDE.md

# pdf.js assets copied out of node_modules at install time; see
# frontend/src/components/documents/pdf-viewer.tsx for why they are served
# locally rather than from a CDN.
frontend/public/pdf.worker.min.mjs
frontend/public/pdf-cmaps/
frontend/public/pdf-fonts/
