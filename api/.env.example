# Postgres runs on 5433 to avoid colliding with any other local Postgres.
DATABASE_URL="postgresql://peoplepay:peoplepay_dev_pw@localhost:5433/peoplepay360?schema=public"

PORT=4000
NODE_ENV=development

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:3000"

# Leave SMTP_HOST empty to record payslip emails in the in-app outbox instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="payroll@peoplepay360.com"
