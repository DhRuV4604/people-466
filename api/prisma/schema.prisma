// PeoplePay360 - HR & Payroll data model
// Design notes:
//  - Employee is the central hub; Contract/Attendance/TimeOff/Payslip all hang off it.
//  - Contracts are period-scoped (dateStart/dateEnd) so payroll can resolve exactly one
//    applicable contract per payroll period instead of relying on a single "current" flag.
//  - Leave balances are derived from Allocation minus approved Requests, never stored raw.
//  - Salary rules carry a sequence so later rules can reference earlier subtotals.
//  - Money and hour columns are NUMERIC rather than float so payroll totals cannot drift.
//    Prisma surfaces them as Decimal, normalised at the API boundary by common/decimal.ts.
//  - Status columns are native enums whose members mirror the const unions in
//    @peoplepay360/shared, so the database rejects an invalid status outright.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enumerations
// Members mirror the const unions exported by @peoplepay360/shared one for one,
// so a value read from the database is directly assignable to the shared DTO
// types without a cast, and an invalid status cannot reach a column at all.

enum EmployeeType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum ScheduleType {
  FULL_TIME
  PART_TIME
  FLEXIBLE
}

enum ContractStatus {
  DRAFT
  RUNNING
  EXPIRED
  CANCELLED
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  INTERNSHIP
  FREELANCE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  MISSING_CHECKOUT
  HALF_DAY
}

enum LeaveUnit {
  DAY
  HOUR
}

enum AllocationStatus {
  DRAFT
  APPROVED
  REFUSED
}

enum LeaveRequestStatus {
  DRAFT
  TO_APPROVE
  APPROVED
  REFUSED
  CANCELLED
}

enum RuleCategory {
  BASIC
  ALLOWANCE
  GROSS
  DEDUCTION
  CONTRIBUTION
  NET
}

enum ComputeType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum PayrunStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  COMPUTED
  VALIDATED
  PAID
  CANCELLED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// ---------------------------------------------------------------- Access control

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String
  passwordHash       String
  role               String // EMPLOYEE | HR_MANAGER | HR_PAYROLL_USER | HR_PAYROLL_MANAGER | ADMIN
  active             Boolean        @default(true)
  /// The issued password works once: the next sign-in has to replace it. Set
  /// when an account is created and whenever an admin reissues one.
  mustChangePassword Boolean        @default(true)
  /// When the invite was emailed, so it is possible to see who never got one.
  invitedAt          DateTime?
  employee           Employee?
  auditLogs          AuditLog[]
  notifications      Notification[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

// ---------------------------------------------------------------- HR master data

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String?
  managerId String?
  employees Employee[]
  createdAt DateTime   @default(now())
}

model JobPosition {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
  contracts Contract[]
  createdAt DateTime   @default(now())
}

model Employee {
  id                String    @id @default(cuid())
  employeeCode      String    @unique
  firstName         String
  lastName          String
  workEmail         String    @unique
  workPhone         String?
  // Personal / payroll-relevant identity
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  // Bank details - absence of these raises a payroll warning before validation
  bankName          String?
  bankAccountNumber String?

  employeeType EmployeeType   @default(FULL_TIME)
  status       EmployeeStatus @default(ACTIVE)
  hireDate     DateTime
  exitDate     DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  jobPositionId String?
  jobPosition   JobPosition? @relation(fields: [jobPositionId], references: [id])

  managerId String?
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[] @relation("EmployeeManager")

  workingScheduleId String?
  workingSchedule   WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])

  /// Required: a person is one record here and one sign-in, never one without
  /// the other. Creating an employee creates the account that goes with it,
  /// and an admin is an employee like everyone else.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contracts        Contract[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  leaveAllocations LeaveAllocation[]
  payslips         Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([status])
}

// ---------------------------------------------------------------- Working schedules

model WorkingSchedule {
  id           String       @id @default(cuid())
  name         String       @unique
  scheduleType ScheduleType @default(FULL_TIME)
  timezone     String       @default("UTC")
  // hoursPerWeek is computed from lines on write; never entered by hand.
  hoursPerWeek Decimal      @default(0) @db.Decimal(8, 2)
  active       Boolean      @default(true)

  lines     WorkingScheduleLine[]
  employees Employee[]
  contracts Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkingScheduleLine {
  id         String          @id @default(cuid())
  scheduleId String
  schedule   WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Sunday .. 6=Saturday
  startTime  String // "09:00"
  endTime    String // "18:00"
  breakHours Decimal         @default(0) @db.Decimal(8, 2)

  @@index([scheduleId])
}

// ---------------------------------------------------------------- Contracts

model Contract {
  id         String   @id @default(cuid())
  name       String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  dateStart DateTime
  dateEnd   DateTime? // null = open-ended
  // Only RUNNING contracts overlapping the payroll period are eligible for
  // payslip computation.
  status    ContractStatus @default(DRAFT)

  wage         Decimal      @db.Decimal(12, 2) // monthly gross basic
  contractType ContractType @default(PERMANENT)

  jobPositionId String?
  jobPosition   JobPosition? @relation(fields: [jobPositionId], references: [id])

  workingScheduleId String?
  workingSchedule   WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])

  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])

  notes    String?
  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([dateStart, dateEnd])
}

// ---------------------------------------------------------------- Attendance

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  checkIn  DateTime
  checkOut DateTime?

  // Derived on write from checkIn/checkOut minus scheduled break.
  workedHours   Decimal @default(0) @db.Decimal(8, 2)
  overtimeHours Decimal @default(0) @db.Decimal(8, 2)

  status AttendanceStatus @default(PRESENT)

  // Correction audit trail - manual edits are restricted to authorised users.
  manuallyEdited Boolean   @default(false)
  editedById     String?
  editedAt       DateTime?
  editReason     String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, checkIn])
  @@index([status])
}

// ---------------------------------------------------------------- Time Off

model TimeOffType {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  unit LeaveUnit @default(DAY)

  // When true, requests must draw from an approved allocation and are blocked
  // once the remaining balance is exhausted.
  requiresAllocation Boolean @default(true)
  requiresApproval   Boolean @default(true)

  // Whether approved leave of this type is paid through payroll.
  paid              Boolean @default(true)
  colorHex          String  @default("#2563eb")
  maxDaysPerRequest Int?
  active            Boolean @default(true)

  requests    LeaveRequest[]
  allocations LeaveAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveAllocation {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  typeId String
  type   TimeOffType @relation(fields: [typeId], references: [id])

  // Allocated quantity in the unit of the type.
  quantity Decimal @db.Decimal(8, 2)

  validFrom DateTime
  validTo   DateTime?

  // Only APPROVED allocations contribute to balance.
  status AllocationStatus @default(DRAFT)

  notes      String?
  approvedBy String?
  approvedAt DateTime?

  requests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, typeId])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  typeId String
  type   TimeOffType @relation(fields: [typeId], references: [id])

  // Set when the request consumes a specific allocation, making the link explicit
  // and auditable rather than inferring it later.
  allocationId String?
  allocation   LeaveAllocation? @relation(fields: [allocationId], references: [id])

  dateFrom DateTime
  dateTo   DateTime
  // Working-day (or hour) count, excluding non-scheduled days.
  duration Decimal  @db.Decimal(8, 2)

  status LeaveRequestStatus @default(TO_APPROVE)

  reason       String?
  approvedBy   String?
  approvedAt   DateTime?
  refusedBy    String?
  refusedAt    DateTime?
  refuseReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, dateFrom])
  @@index([status])
}

// ---------------------------------------------------------------- Salary config

model SalaryStructure {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?
  active      Boolean @default(true)

  rules     SalaryRule[]
  contracts Contract[]
  payruns   Payrun[]
  payslips  Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalaryRule {
  id   String @id @default(cuid())
  name String
  code String // referenced inside formulas, e.g. BASIC, HRA

  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  category RuleCategory

  // Lower sequence computes first, so later rules can reference earlier results.
  sequence Int @default(100)

  computeType ComputeType @default(FIXED)

  amountFixed      Decimal? @db.Decimal(12, 2)
  amountPercentage Decimal? @db.Decimal(9, 4)
  // Code of the rule the percentage applies to, e.g. "BASIC".
  percentageBase   String?
  // JS-like expression evaluated in a sandbox with prior rule codes in scope.
  formula          String?

  // Optional guard expression; rule is skipped when it evaluates false.
  condition String?

  appearsOnPayslip Boolean @default(true)
  active           Boolean @default(true)
  note             String?

  lines PayslipLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([structureId, code])
  @@index([structureId, sequence])
}

// ---------------------------------------------------------------- Payroll

model Payrun {
  id   String @id @default(cuid())
  name String

  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  status PayrunStatus @default(DRAFT)

  departmentFilter   String?
  employeeTypeFilter String?

  computedAt  DateTime?
  validatedAt DateTime?
  paidAt      DateTime?
  paidBy      String?

  payslips Payslip[]
  emails   EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodStart, periodEnd])
  @@index([status])
}

model Payslip {
  id     String @id @default(cuid())
  number String @unique

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  payrunId String?
  payrun   Payrun? @relation(fields: [payrunId], references: [id], onDelete: Cascade)

  // Snapshot of the contract that applied to this period - kept even if the
  // contract later changes, so historical payslips stay reproducible.
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])

  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  status PayslipStatus @default(DRAFT)

  workedDays    Decimal @default(0) @db.Decimal(8, 2)
  workedHours   Decimal @default(0) @db.Decimal(8, 2)
  leaveDays     Decimal @default(0) @db.Decimal(8, 2)
  overtimeHours Decimal @default(0) @db.Decimal(8, 2)

  basicWage       Decimal @default(0) @db.Decimal(12, 2)
  grossPay        Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  netPay          Decimal @default(0) @db.Decimal(12, 2)

  // Warnings surfaced before validation, e.g. missing bank details. A native
  // text[] so the API can read it straight back as string[].
  warnings String[]

  lines  PayslipLine[]
  emails EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, periodStart])
  @@index([payrunId])
  @@index([status])
}

model PayslipLine {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  ruleId String?
  rule   SalaryRule? @relation(fields: [ruleId], references: [id])

  // Denormalised so the payslip renders identically even if the rule is edited later.
  code     String
  name     String
  category RuleCategory
  sequence Int          @default(100)

  quantity Decimal @default(1) @db.Decimal(10, 2)
  rate     Decimal @default(100) @db.Decimal(10, 2)
  amount   Decimal @default(0) @db.Decimal(12, 2)

  @@index([payslipId, sequence])
}

// ---------------------------------------------------------------- Delivery

model EmailLog {
  id String @id @default(cuid())

  payslipId String?
  payslip   Payslip? @relation(fields: [payslipId], references: [id], onDelete: SetNull)

  payrunId String?
  payrun   Payrun? @relation(fields: [payrunId], references: [id], onDelete: SetNull)

  toEmail        String
  toName         String?
  subject        String
  body           String
  attachmentName String?

  status EmailStatus @default(SENT)
  error  String?

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([payrunId])
}

// ---------------------------------------------------------------- Audit trail

model AuditLog {
  id String @id @default(cuid())

  // Nullable and denormalised on purpose: the trail has to survive the account
  // that made the change, so deleting a user must not take their history with
  // them or leave rows that can no longer say who acted.
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName String
  userRole String

  action      AuditAction
  /// Model name, e.g. "Employee". Free text rather than an enum so a new
  /// resource does not need a migration to be auditable.
  entity      String
  entityId    String?
  /// What the record was called at the time, so a deleted row still reads as
  /// something a person recognises.
  entityLabel String?

  /// Field-level diff, `{ field: { from, to } }`. Null for a create or delete,
  /// where the whole record is the change.
  changes  Json?
  /// The record as it was, for a delete. Nothing else can recover it.
  snapshot Json?

  method String
  path   String
  ip     String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REFUSE
  CANCEL
  COMPUTE
  VALIDATE
  PAY
  SEND
  LOGIN
}

// ---------------------------------------------------------------- Notifications

model Notification {
  id String @id @default(cuid())

  /// Who it is for. Notifications are per-recipient rows rather than one row
  /// with many readers, so read state is simply a column.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Dotted event name, e.g. "leave.filed". The client maps it to an icon.
  type  String
  title String
  body  String?
  /// Where clicking it should go.
  href  String?

  /// Who caused it. Denormalised so the row reads correctly forever.
  actorName String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Organisation-wide settings that are not reference data: a single row the
/// API reads on the paths that enforce them. Kept as one pinned row rather
/// than a key/value table so each setting keeps its own column type, and the
/// defaults below are what an install behaves like before anyone edits it.
model AppSettings {
  /// Always SINGLETON_ID; the column exists only so the row has a primary key.
  id String @id @default("singleton")

  /// How many times an employee may check in on one calendar day. 1 makes the
  /// punch card a once-a-day control, which is the default an install starts
  /// on; a higher number allows split shifts.
  maxCheckInsPerDay Int @default(1)

  /// Whether the self-service punch card confirms before closing a shift. It
  /// matters when the day's punches are capped, because checking out may be
  /// the last one available.
  warnOnCheckOut Boolean @default(true)

  updatedAt DateTime @updatedAt
}
