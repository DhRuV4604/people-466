{
  "name": "@peoplepay360/shared",
  "version": "2.0.0",
  "private": true,
  "description": "Types, enums and domain contracts shared by the API and web apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
